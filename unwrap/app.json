{
  "expo": {
    "name": "Unwrap",
    "slug": "unwrap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unwrap",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.aydinapp.unwrap",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "appleTeamId": "G2T885G2XY",
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Sohbet dökümü",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.zip-archive",
              "public.plain-text",
              "public.text",
              "public.json"
            ]
          },
          {
            "CFBundleTypeName": "Sohbet dökümü",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.zip-archive",
              "public.plain-text",
              "public.text",
              "public.json"
            ]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "com.aydinapp.unwrap",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/zip"
            },
            {
              "scheme": "content",
              "mimeType": "text/plain"
            },
            {
              "scheme": "file",
              "mimeType": "application/zip"
            },
            {
              "scheme": "file",
              "mimeType": "text/plain"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/zip"
            },
            {
              "scheme": "content",
              "mimeType": "text/plain"
            },
            {
              "scheme": "file",
              "mimeType": "application/zip"
            },
            {
              "scheme": "file",
              "mimeType": "text/plain"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-localization", { "supportsRTL": true }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "aydinapp",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5bd4e8a-173f-4154-93f5-36ee77154691"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/b5bd4e8a-173f-4154-93f5-36ee77154691"
    }
  }
}
