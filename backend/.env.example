# Anthropic Console'dan (console.anthropic.com) alınan API anahtarı.
ANTHROPIC_API_KEY=

# OpenAI platform'dan (platform.openai.com) alınan API anahtarı.
# Yalnızca /api/transcribe (sesli not) için gerekli.
OPENAI_API_KEY=

# Opsiyonel ama üretimde ŞİDDETLE ÖNERİLİR: uç noktayı rastgele erişime karşı
# korumak için paylaşılan bir sır. Ayarlarsan mobil uygulamanın da aynı değeri
# EXPO_PUBLIC_APP_SHARED_SECRET olarak bilmesi gerekir.
#
# UYARI: Bu sır, EXPO_PUBLIC_ önekiyle mobil uygulama paketine gömülür ve APK/IPA
# dosyasından çıkarılabilir — yani "gizli" değil, sadece rastgele/otomatik
# taramaları engelleyen basit bir filtre. Gerçek kötüye kullanım koruması
# Anthropic/OpenAI Console'daki API anahtarı bazlı kullanım limitlerinden gelir;
# oradan da harcama/kullanım uyarısı kurman önerilir. Bu değeri boş bırakırsan
# uç noktalar tamamen kimliksiz erişime açık kalır (yalnızca lib/rateLimit.ts'teki
# best-effort hız sınırlamasıyla korunur) — Vercel'de mutlaka ayarla.
APP_SHARED_SECRET=

# Opsiyonel: varsayılan claude-opus-5 yerine başka bir model kullanmak için.
ANTHROPIC_MODEL=

# Opsiyonel: varsayılan whisper-1 yerine başka bir OpenAI transkripsiyon
# modeli kullanmak için (ör. gpt-4o-transcribe).
OPENAI_TRANSCRIBE_MODEL=
