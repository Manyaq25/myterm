        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#00A896"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#C4EADF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E1C1A"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Uygulama kilidini açmak için Face ID kullanılıyor."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sesli notlarını takip maddesine çevirmek için mikrofon erişimi gerekiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Takip maddesi çıkarmak için görsel seçmene izin gerekiyor.",
          "cameraPermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Ekran görüntünü bulup takip maddesine çevirmek için galerine erişim gerekiyor.",
          "savePhotosPermission": "Bu uygulama galerine fotoğraf kaydetmiyor.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withAdjustNothingKeyboard"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.manyaq25.benimyerimetakipet",
      "appleTeamId": "G2T885G2XY",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.manyaq25.benimyerimetakipet"
        ]
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "tg"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.manyaq25.benimyerimetakipet",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
