{
  "expo": {
    "name": "Benim Yerime Takip Et",
    "slug": "benim-yerime-takip-et",
    "scheme": "benim-yerime-takip-et",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e9b0959d-b211-4b85-8b32-c0f4a2d929e2"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0E5C56"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0E5C56",
          "dark": {
            "backgroundColor": "#0E1A18"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Uygulama kilidini açmak için Face ID kullanılıyor."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sesli notlarını takip maddesine çevirmek için mikrofon erişimi gerekiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Takip maddesi çıkarmak için görsel seçmene izin gerekiyor.",
          "cameraPermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Ekran görüntünü bulup takip maddesine çevirmek için galerine erişim gerekiyor.",
          "savePhotosPermission": "Bu uygulama galerine fotoğraf kaydetmiyor.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      "@bacons/apple-targets"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.manyaq25.benimyerimetakipet",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.manyaq25.benimyerimetakipet"]
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["whatsapp", "tg"]
      }
    },
    "android": {
      "package": "com.manyaq25.benimyerimetakipet",
      "adaptiveIcon": {
        "backgroundColor": "#0E5C56",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9b0959d-b211-4b85-8b32-c0f4a2d929e2"
      }
    },
    "owner": "manyaq-app"
  }
}
