{
  "expo": {
    "name": "Synvia AI",
    "slug": "benim-yerime-takip-et",
    "scheme": "benim-yerime-takip-et",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/db715a1a-2a9d-4096-888e-7f9c672e1b40"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-updates",
      [
